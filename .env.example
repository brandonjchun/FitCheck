# Infrastructure credentials, read by docker-compose.yml.
#
# Compose auto-loads a .env from the project root (this directory) for variable
# substitution. That is a different file from backend/.env, which configures the
# Python process -- backend/.env is named explicitly under `env_file:` because
# Compose does not look there for substitution.
#
# Copy this to .env and fill in real values. .env is gitignored; this file is
# committed so a fresh clone knows which variables are required.
#
# Generate values with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# token_urlsafe is used deliberately: its alphabet is URL-safe, so the value can
# be embedded directly in the DATABASE_URL and REDIS_URL that Compose builds
# without percent-encoding.

# Postgres superuser password for the `fitcheck` role.
#
# NOTE: this only takes effect when the pgdata volume is first created. If the
# volume already exists, changing this does nothing -- rotate the live password
# instead:
#   docker compose exec postgres psql -U fitcheck -d fitcheck \
#     -c "ALTER USER fitcheck WITH PASSWORD 'the-new-value';"
POSTGRES_PASSWORD=

# Redis password, applied via `--requirepass`. Redis ships with no password and
# holds the session store here, so read access to it is read access to every
# logged-in account.
REDIS_PASSWORD=
