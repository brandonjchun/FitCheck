# Copy to .env and adjust. .env is gitignored; this file is committed so a
# fresh clone knows which variables exist.

# Credentials must match POSTGRES_PASSWORD / REDIS_PASSWORD in the ROOT .env
# (see ../.env.example). This file configures the Python process; the root one
# configures the containers. They talk to the same two services, so the
# passwords have to agree.
#
# Note the empty user in the Redis URL -- `redis://:password@host` -- because
# Redis authenticates with a password and no username by default.
DATABASE_URL=postgresql+psycopg://fitcheck:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/fitcheck
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@localhost:6379/0

MAX_UPLOAD_BYTES=2097152

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- LLM extraction ---
# Which provider backs structured extraction: gemini | ollama
LLM_PROVIDER=gemini

# Gemini: free-tier key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Ollama: local daemon, no key. `ollama pull llama3.1` before first use.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- USAJOBS (optional) ---
# Only needed if a `usajobs` source is seeded. Free, instant key from
# https://developer.usajobs.gov/apirequest/ -- their terms ask that the
# User-Agent be the email the key was registered to, hence both values.
# Without these, crawling a usajobs source raises rather than enumerating
# nothing, so an unconfigured key cannot look like an agency with no openings.
USAJOBS_API_KEY=
USAJOBS_EMAIL=
