# --- Editors ---
# Ignore .vscode/* (not .vscode/) so the two files below can be re-included --
# git cannot un-ignore a file whose parent directory is itself excluded.
.vscode/*
# Keep the shared workspace config: it pins the interpreter to backend/.venv
# so a fresh clone doesn't silently run against a global Python.
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp

